@using CarType = Wasm.Client.Type;

<div class="offcanvas offcanvas-start" tabindex="-1" id="@Id" aria-labelledby="offcanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasLabel">Generation @Generation?.SequenceNumber @Type?.Name @Type?.Style?.Name</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        Content for the offcanvas goes here. You can place just about any Bootstrap component or custom elements here.
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = "offcanvas";
    [Parameter] public Generation? Generation { get; set; }
    [Parameter] public CarType? Type { get; set; }
}