@page "/group/{name?}" //route constraint: name:int ; catch-all: {*name} ignores '/'
@inject HttpClient Http

<a href="">All groups</a>

@if (string.IsNullOrEmpty(Name))
{
    <p>No group name passed.</p>
    return;
}

<h3>@Name</h3>
@if (brands != null)
{
    <ul class="list-group">
        @foreach (var brand in brands)
        {
            <li class="list-group-item">
                @if (!string.IsNullOrEmpty(brand.LogoUrl))
                {
                    <img src="@brand.LogoUrl" class="card-img-top" alt="@brand.Name" style="max-width: 64px;">
                }
                &nbsp;<a href="/brand/@brand.Id">@brand.Name</a>&nbsp;
                <small>@brand.Country?.Name</small>
            </li>
        }
    </ul>
}

@code {
    [Parameter] public string? Name { get; set; }
    private IEnumerable<Brand>? brands;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Name)) return;
        brands = await Http.GetFromJsonAsync<IEnumerable<Brand>>("api/brand/" + Name);
    }
}