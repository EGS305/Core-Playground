@page "/group/{name?}" //route constraint: name:int ; catch-all: {*name} ignores '/'
@inject HttpClient Http

<a href="">All groups</a>

@if (string.IsNullOrEmpty(Name))
{
    <p>No group name passed.</p>
    return;
}

<h3>@Name</h3>
@if (brands != null)
{
    foreach (var brand in brands)
    {
        <div>
            <img src="@brand.LogoUrl" alt="@brand.Name" width="48" />
            <a href="/brand/@brand.Id">@brand.Name&nbsp;<small>(@brand.Country?.Name)</small></a>
        </div>
    }
}

@code {
    [Parameter] public string? Name { get; set; }
    private IEnumerable<Brand>? brands;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Name)) return;
        brands = await Http.GetFromJsonAsync<IEnumerable<Brand>>("api/brand");
    }
}