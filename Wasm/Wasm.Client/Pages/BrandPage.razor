@page "/brand/{id:int}"
@inject HttpClient Http

@if (Brand == null)
{
    <p>Brand not found.</p>
    return;
}

<a href="/group/@Brand.Group.Name">@Brand.Group.Name</a>

<h3>@Brand.Name</h3>
<QuickGrid Class="table" ItemsProvider="LoadTypes" TGridItem="Client.Type">
    <PropertyColumn Property="type => type.Name" />
    <PropertyColumn Property="type => type.ProductionStart" title="From" />
    <PropertyColumn Property="type => type.ProductionEnd" Title="Until" />
    <PropertyColumn Property="type => type.Quantity" />
</QuickGrid>

@code {
    [Parameter] public int Id { get; set; }
    private Brand? Brand { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id <= 0) return;
        Brand = await Http.GetFromJsonAsync<Brand>("api/brand/" + Id);
    }

    private async ValueTask<GridItemsProviderResult<Client.Type>> LoadTypes(GridItemsProviderRequest<Client.Type> request)
    {
        var result = await Http.GetFromJsonAsync<ICollection<Client.Type>>("api/type/" + Id);

        return new GridItemsProviderResult<Client.Type>
        {
            Items = result ?? Array.Empty<Client.Type>(),
            TotalItemCount = result?.Count() ?? 0
        };
    }
}