@page "/brand/{id:int}"
@inject HttpClient Http
@inject IJSRuntime JS
@using CarType = Wasm.Client.Type;

@if (Brand == null)
{
    <p>Brand not found.</p>
    return;
}

<a href="/group/@Brand.Group.Name">@Brand.Group.Name</a>

<div class="car-grid">
    <div>
        <img src="@Brand.LogoUrl" alt="@Brand.Name" style="max-width: 64px;">
        <h3>@Brand.Name</h3>
        <QuickGrid Class="table" ItemsProvider="LoadModels" TGridItem="Model">
            <TemplateColumn Title="Model">
                <span class="btn btn-link p-0 m-0" @onclick="() => SelectedModel = context">@GetModelNames(context)</span>
            </TemplateColumn>
            <PropertyColumn Property="model => model.Generations.Count" Title="Generations" />
        </QuickGrid>
    </div>
    <div>
        @if (SelectedModel != null && SelectedModel.Generations != null)
        {
            <h4>@GetModelNames(SelectedModel)</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Style</th>
                        <th>From</th>
                        <th>Until</th>
                        <th>Nr.</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var generation in SelectedModel.Generations)
                    {
                        <tr>
                            <th colspan="4">Generation @generation.SequenceNumber</th>
                        </tr>
                        @foreach (var type in generation.Types)
                        {
                            <tr>
                                <td><span class="btn btn-link p-0 m-0" @onclick="() => OnTypeSelected(generation, type)">@type.Name</span></td>
                                <td>@type.Style.Name</td>
                                <td>@type.ProductionStart</td>
                                <td>@type.ProductionEnd</td>
                                <td>@type.Quantity.ToString("N0")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<TypeOffcanvas Id="TypeDetailPanel" Generation="SelectedGeneration" Type="SelectedType" />

@code {
    [Parameter] public int Id { get; set; }
    private Brand? Brand { get; set; }
    private Model? SelectedModel { get; set; }
    private Generation? SelectedGeneration { get; set; }
    private CarType? SelectedType { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id <= 0) return;
        Brand = await Http.GetFromJsonAsync<Brand>("api/brand/" + Id);
    }

    private async ValueTask<GridItemsProviderResult<Model>> LoadModels(GridItemsProviderRequest<Model> request)
    {
        var result = await Http.GetFromJsonAsync<ICollection<Model>>("api/model/" + Id);

        return new GridItemsProviderResult<Model>
        {
            Items = result ?? Array.Empty<Model>(),
            TotalItemCount = result?.Count() ?? 0
        };
    }

    private string GetModelNames(Model model)
    {
        return string.Join(", ", model.Generations.SelectMany(gen => gen.Types).Select(type => type.Name).Order().Distinct());
    }

    private async Task OnTypeSelected(Generation generation, CarType type)
    {
        SelectedGeneration = generation;
        SelectedType = type;
        await JS.InvokeVoidAsync("showOffcanvas", "#TypeDetailPanel");
    }
}